# CognoDB Cloud (Bolt 5.x) — backend only, never exposed to the frontend
COGNODB_URI=bolt+s://your-instance.cognodb.cloud:7687
COGNODB_USERNAME=your-username
COGNODB_PASSWORD=your-password

# Express server
PORT=4000
FRONTEND_URL=http://localhost:5173

# Frontend (public) — points at the deployed Express API
VITE_API_URL=http://localhost:4000
